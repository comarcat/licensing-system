[Unit]
Description=Licensing API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/licensing/api
ExecStart=/usr/local/bin/dotnet /var/www/licensing/api/LicensingApi.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=licensing-api
User=deploy
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
EnvironmentFile=/etc/licensing-api/env

[Install]
WantedBy=multi-user.target
