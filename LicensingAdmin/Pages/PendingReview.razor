@page "/pending-review"
@using Microsoft.EntityFrameworkCore
@using LicensingAdmin.Auth
@attribute [Authorize(Policy = AuthPolicies.ReviewAccess)]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState

<MudText Typo="Typo.h4" Class="mb-1">Pending Review</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Activations awaiting approval — auto-locks if unresolved after the 15-day grace window.
</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing waiting on review right now.</MudText>
}
else
{
    <MudTextField @bind-Value="_search" Immediate="true" Class="mb-4" Style="max-width:420px"
                  Label="Buscar" Placeholder="Clave, producto, cliente o correo…"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

    var filtered = _items.Where(Matches).ToList();
    @if (filtered.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Ningún resultado para "@_search".</MudText>
    }
    @foreach (var a in filtered)
    {
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            @* align-center utility class instead of the non-existent MudGrid.AlignItems parameter (MUD0002). *@
            <MudGrid Class="align-center">
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.subtitle1">@a.License.Product.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family:monospace">
                        Key ...@Last(a.License.LicenseKey, 4)
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    @if (string.IsNullOrWhiteSpace(a.License.CustomerName) && string.IsNullOrWhiteSpace(a.License.CustomerEmail))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Sin datos de cliente</MudText>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(a.License.CustomerName))
                        {
                            <MudText Typo="Typo.body2">@a.License.CustomerName</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(a.License.CustomerEmail))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@a.License.CustomerEmail</MudText>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudText Typo="Typo.body2">Install: @a.InstallGuid</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Detected: @a.FirstActivatedAtUtc.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudText Typo="Typo.body2" Color="Color.Warning">
                        Grace ends: @(a.ReviewDeadlineUtc?.ToString("yyyy-MM-dd") ?? "—")
                    </MudText>
                    @if (!string.IsNullOrEmpty(a.ReviewNotes))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@a.ReviewNotes</MudText>
                    }
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex ga-2 justify-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                               OnClick="@(() => Resolve(a, approve: true))">Approve</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => Resolve(a, approve: false))">Reject</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@code {
    private bool _loading = true;
    private List<Activation> _items = new();
    private string _search = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private bool Matches(Activation a)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var needle = _search.Trim();
        return Contains(a.License.LicenseKey, needle)
            || Contains(a.License.Product.Name, needle)
            || Contains(a.License.CustomerName, needle)
            || Contains(a.License.CustomerEmail, needle);
    }

    private static bool Contains(string? haystack, string needle) =>
        !string.IsNullOrEmpty(haystack) && haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _items = await db.Activations
            .Include(a => a.License)
            .ThenInclude(l => l.Product)
            .Where(a => a.Status == ActivationStatus.PendingReview)
            .OrderBy(a => a.ReviewDeadlineUtc)
            .ToListAsync();
        _loading = false;
    }

    private async Task Resolve(Activation activation, bool approve)
    {
        var reviewer = CurrentAdmin.Email((await AuthState.GetAuthenticationStateAsync()).User);
        if (string.IsNullOrWhiteSpace(reviewer))
        {
            // Auth state flipped to anonymous mid-circuit (account disabled / re-validated).
            // Refuse rather than stamp an activation and an audit row with no attributable
            // actor — same non-repudiation guard as LicenseIssuanceService (IssuedBy).
            Snackbar.Add("Tu sesión ya no es válida. Vuelve a iniciar sesión.", Severity.Error);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Activations.FirstOrDefaultAsync(a => a.Id == activation.Id);
        if (entity is null) return;

        entity.Status = approve ? ActivationStatus.Approved : ActivationStatus.Rejected;
        entity.ReviewDeadlineUtc = null;
        if (approve) entity.ApprovedAtUtc = DateTime.UtcNow; else entity.RejectedAtUtc = DateTime.UtcNow;
        entity.ReviewedBy = reviewer;

        db.AuditLogEntries.Add(new AuditLogEntry
        {
            Id = Guid.NewGuid(),
            Actor = entity.ReviewedBy,
            EntityType = "Activation",
            EntityId = entity.Id.ToString(),
            Action = approve ? "Approved" : "Rejected",
        });

        await db.SaveChangesAsync();
        Snackbar.Add(approve ? "Activation approved." : "Activation rejected.", approve ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }

    private static string Last(string s, int n) => s.Length <= n ? s : s[^n..];
}
