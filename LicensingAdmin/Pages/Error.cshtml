@page "/Error"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@* AllowAnonymous so the FallbackPolicy (requires an authenticated user) does not itself
   block the error page when an unauthenticated request faults. *@
<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>Error</title></head>
<body>
    <h1>Something went wrong.</h1>
    <p>Please try again or contact an administrator.</p>
</body>
</html>
