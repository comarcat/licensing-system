@page "/licenses/new"
@* Explicit namespace: the folder Pages/Licenses/ would otherwise derive
   LicensingAdmin.Pages.Licenses, which collides with the existing Pages/Licenses.razor
   list component (a type of that same name). Routing is unaffected by the namespace. *@
@namespace LicensingAdmin.Pages.NewLicense
@using System.Linq
@using LicensingAdmin.Auth
@using LicensingAdmin.Licensing
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Policy = AuthPolicies.IssueAccess)]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject LicenseIssuanceService Issuance
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudText Typo="Typo.h4" Class="mb-1">Generar nueva licencia</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Crea el producto (o reutiliza uno) y emite una clave firmada. Los campos del modelo y el
    tope de activaciones quedan congelados en la clave en el momento de la emisión.
</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_issued is not null)
{
    <MudPaper Class="pa-6" Elevation="2" MaxWidth="640px">
        <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="mb-2">Licencia emitida</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Clave</MudText>
        <div class="d-flex align-center ga-2 mb-4">
            <MudText Typo="Typo.h6" Style="font-family:monospace;letter-spacing:1px">@_issued.LicenseKey</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                           aria-label="Copiar" OnClick="CopyKeyAsync" />
        </div>
        <MudButton Href="/licenses" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Volver a Licencias
        </MudButton>
        <MudButton OnClick="ResetForm" Variant="Variant.Text" Class="ml-2">Emitir otra</MudButton>
    </MudPaper>
}
else
{
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudSwitch @bind-Value="_newProduct" Label="Nuevo producto" Color="Color.Primary" />
            </MudItem>

            @if (_newProduct)
            {
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_newName" Label="Nombre del producto" Required="true"
                                  RequiredError="El nombre es obligatorio." Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_newVendor" Label="Fabricante" Required="true"
                                  RequiredError="El fabricante es obligatorio." Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_newVersion" Label="Versión actual (opcional)" Immediate="true" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" md="8">
                    <MudSelect T="Guid" @bind-Value="_existingProductId" Label="Producto"
                               Required="true" RequiredError="Elige un producto.">
                        @foreach (var p in _products)
                        {
                            <MudSelectItem T="Guid" Value="@p.Id">@p.Name — @p.Vendor</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_products.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            No hay productos todavía — activa "Nuevo producto".
                        </MudText>
                    }
                </MudItem>
            }

            <MudItem xs="12" md="8">
                <MudText Typo="Typo.subtitle2" Class="mt-2">Modelo de licencia</MudText>
                <MudCheckBox @bind-Value="_machine" Label="Machine" Dense="true" />
                <MudCheckBox @bind-Value="_user" Label="User" Dense="true" />
                <MudCheckBox @bind-Value="_floating" Label="Floating" Dense="true" />
                <MudCheckBox @bind-Value="_subscription" Label="Subscription" Dense="true" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_maxActivations" Label="Máx. activaciones" Min="1" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_expiry" Label="Vencimiento de suscripción"
                               Disabled="@(!_subscription)" />
            </MudItem>

            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_customerEmail" Label="Email del cliente (opcional)" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_customerName" Label="Nombre del cliente (opcional)" Immediate="true" />
            </MudItem>

            <MudItem xs="12" md="8">
                <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@_submitting" StartIcon="@Icons.Material.Filled.VpnKey">
                    @(_submitting ? "Emitiendo…" : "Emitir licencia")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
}

@code {
    private MudForm _form = default!;

    private bool _loading = true;
    private bool _submitting;
    private List<SoftwareProduct> _products = new();
    private License? _issued;

    private bool _newProduct;
    private string? _newName;
    private string? _newVendor;
    private string? _newVersion;
    private Guid _existingProductId;

    private bool _machine = true;
    private bool _user;
    private bool _floating;
    private bool _subscription;

    private int _maxActivations = 5;
    private DateTime? _expiry;
    private string? _customerEmail;
    private string? _customerName;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _products = await db.SoftwareProducts.OrderBy(p => p.Name).ToListAsync();
        _loading = false;
    }

    private LicenseModel BuildModel()
    {
        var m = LicenseModel.None;
        if (_machine) m |= LicenseModel.Machine;
        if (_user) m |= LicenseModel.User;
        if (_floating) m |= LicenseModel.Floating;
        if (_subscription) m |= LicenseModel.Subscription;
        return m;
    }

    private async Task SubmitAsync()
    {
        if (_submitting) return;

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var issuedBy = CurrentAdmin.Email(user);
        if (string.IsNullOrWhiteSpace(issuedBy))
        {
            Snackbar.Add("Tu sesión ya no es válida. Vuelve a iniciar sesión.", Severity.Error);
            return;
        }

        if (_newProduct)
        {
            if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newVendor))
            {
                Snackbar.Add("Nombre y fabricante del producto son obligatorios.", Severity.Warning);
                return;
            }
        }
        else if (_existingProductId == Guid.Empty)
        {
            Snackbar.Add("Elige un producto o activa \"Nuevo producto\".", Severity.Warning);
            return;
        }

        if (BuildModel() == LicenseModel.None)
        {
            Snackbar.Add("Selecciona al menos un modelo de licencia.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var model = BuildModel();
            var request = new LicenseIssuanceRequest
            {
                ExistingProductId = _newProduct ? null : _existingProductId,
                NewProductName = _newProduct ? _newName!.Trim() : null,
                NewProductVendor = _newProduct ? _newVendor!.Trim() : null,
                NewProductVersion = string.IsNullOrWhiteSpace(_newVersion) ? null : _newVersion!.Trim(),
                Model = model,
                MaxActivations = _maxActivations,
                SubscriptionExpiryUtc = model.HasFlag(LicenseModel.Subscription)
                    ? _expiry?.ToUniversalTime()
                    : null,
                CustomerEmail = string.IsNullOrWhiteSpace(_customerEmail) ? null : _customerEmail!.Trim(),
                CustomerName = string.IsNullOrWhiteSpace(_customerName) ? null : _customerName!.Trim(),
                IssuedBy = issuedBy,
            };

            _issued = await Issuance.IssueAsync(request);
            Snackbar.Add("Licencia emitida.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo emitir la licencia: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task CopyKeyAsync()
    {
        if (_issued is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _issued.LicenseKey);
            Snackbar.Add("Clave copiada.", Severity.Info);
        }
        catch
        {
            Snackbar.Add("No se pudo copiar automáticamente; cópiala a mano.", Severity.Warning);
        }
    }

    private async Task ResetForm()
    {
        _issued = null;
        _newProduct = false;
        _newName = _newVendor = _newVersion = null;
        _existingProductId = Guid.Empty;
        _machine = true;
        _user = _floating = _subscription = false;
        _maxActivations = 5;
        _expiry = null;
        _customerEmail = _customerName = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        _products = await db.SoftwareProducts.OrderBy(p => p.Name).ToListAsync();
    }
}
