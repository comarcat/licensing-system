@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    Layout = null;
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Miautrix Licensing System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <main class="landing">
        <div class="landing-card">
            <div class="landing-logo">⚙</div>
            <h1 class="landing-title">Miautrix</h1>

            @if (authenticated)
            {
                <p class="landing-tagline">Sesión activa detectada.</p>
                <a class="landing-cta" href="/dashboard">Ir al panel →</a>
            }
            else
            {
                <p class="landing-tagline">
                    Este es un sistema interno de Miautrix. Para más información sobre
                    nuestros productos o para contactarnos, visita nuestro sitio principal.
                </p>
                <a class="landing-cta" href="https://miautrix.tech" id="contact-link">Contáctanos →</a>
                <p class="landing-countdown">
                    Serás redirigido automáticamente en <span id="countdown">30</span> segundos…
                </p>
                <a class="landing-staff-link" href="/Account/Login">Acceso de staff</a>

                <script>
                    (function () {
                        var seconds = 30;
                        var el = document.getElementById('countdown');
                        var timer = setInterval(function () {
                            seconds -= 1;
                            if (el) el.textContent = seconds;
                            if (seconds <= 0) {
                                clearInterval(timer);
                                window.location.href = 'https://miautrix.tech';
                            }
                        }, 1000);
                    })();
                </script>
            }
        </div>
    </main>
</body>
</html>
