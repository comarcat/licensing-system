@inherits LayoutComponentBase
@using LicensingAdmin.Auth

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">⚙ License Admin</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-4">@context.User.Identity?.Name</MudText>
                <MudButton Href="/Account/Logout" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Logout" Size="Size.Small">
                    Cerrar sesión
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent">
        <MudNavMenu>
            <AuthorizeView Policy="@AuthPolicies.ViewerAccess">
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthPolicies.ViewerAccess">
                <MudNavLink Href="licenses" Icon="@Icons.Material.Filled.VpnKey">Licencias</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthPolicies.ReviewAccess">
                <MudNavLink Href="pending-review" Icon="@Icons.Material.Filled.PendingActions">Pending Review</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthPolicies.IssueAccess">
                <MudNavLink Href="licenses/new" Icon="@Icons.Material.Filled.AddCircleOutline">Generar licencia</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthPolicies.AdminUserAccess">
                <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.ManageAccounts">Usuarios admin</MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
